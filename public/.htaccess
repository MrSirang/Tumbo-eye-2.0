<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Serve existing files/folders as-is (includes /admin static assets if present)
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # SPA fallback so /admin, /signin, /about work on refresh/direct open
  RewriteRule ^ index.html [L]
</IfModule>
