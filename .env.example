# Frontend API (optional — defaults to /api via Vite proxy in dev)
VITE_API_URL=/api

# Optional absolute API origin for uploaded images in production
# VITE_API_ORIGIN=https://api.example.com

# Admin Opportunities CMS (served by .NET API)
VITE_ADMIN_URL=http://localhost:5000/admin/

# Google OAuth Web Client ID (same as backend Google:ClientId)
VITE_GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com
