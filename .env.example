# Frontend API
# Local (Vite proxy): /api
# Production example: https://YOUR-API-HOST/api
VITE_API_URL=/api

# Optional absolute API origin for uploaded images in production
# VITE_API_ORIGIN=https://YOUR-API-HOST

# Admin is served on the same site at /admin/
# If API is on another domain, set it in public/admin/config.js:
# window.TUMBO_API_BASE = "https://YOUR-API-HOST";

# Google OAuth Web Client ID (same value as backend Google:ClientId)
# Authorized JavaScript origins must include:
# - http://localhost:5173
# - https://tumbo.ardntlogic.com
VITE_GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com
